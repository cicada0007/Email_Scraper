{
  "manifest_version": 3,
  "name": "TouchMail — Email Finder",
  "version": "1.0.0",
  "description": "Find verified emails with a single touch. Extract, verify, and export email addresses directly from Google search results.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.google.com/*",
    "https://google.com/*",
    "http://localhost:3847/*",
    "http://127.0.0.1:3847/*",
    "https://cloudflare-dns.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["utils/regex.js", "utils/export.js", "icons/icon-128.png"],
      "matches": [
        "https://www.google.com/*",
        "https://google.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://google.com/search*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
