{
  "name": "touchmail",
  "version": "1.0.0",
  "private": true,
  "description": "TouchMail — Find verified emails with a single touch.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node dashboard/server.js",
    "app": "electron .",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.touchmail.app",
    "productName": "TouchMail",
    "copyright": "Copyright © 2026 TouchMail",
    "directories": {
      "output": "dist",
      "buildResources": "build-assets"
    },
    "files": [
      "electron/**/*",
      "dashboard/**/*",
      "icons/**/*",
      "!dashboard/node_modules"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icons/icon-128.png",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "TouchMail ${version}",
      "backgroundColor": "#0f0f1a",
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "icons/icon-128.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TouchMail"
    },
    "linux": {
      "icon": "icons/icon-128.png",
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
